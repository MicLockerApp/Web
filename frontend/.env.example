# Copy to .env.local for local development.
# The website talks directly to the MicLocker app backend.
REACT_APP_API_URL=https://api.miclockerapp.com
# Stripe publishable key (same account the apps use). pk_test_... for testing.
REACT_APP_STRIPE_PUBLISHABLE_KEY=
# Google Maps browser key (Discover Pros map + address search)
REACT_APP_GOOGLE_MAPS_API_KEY=
# WishKit project key for the /feedback board (same key as iOS WISHKIT_API_KEY)
REACT_APP_WISHKIT_PROJECT_KEY=
