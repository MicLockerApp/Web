# Application Settings
ENVIRONMENT=development
SECRET_KEY=miclocker-secret-key-change-in-production-2024
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# MongoDB (will be set by system)
MONGO_URL=mongodb://localhost:27017

# AWS S3 Configuration (leave empty to use local storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1

# Local Storage Path
LOCAL_STORAGE_PATH=/app/uploads

# Platform Settings
PLATFORM_FEE_PERCENT=3

# Payment Processing Fee (Stripe-like)
PAYMENT_PROCESSING_PERCENT=3.19
PAYMENT_PROCESSING_FIXED=0.49
